#!/usr/bin/env perl
use strict;
use warnings;

# train_zstd_dict
#
# Walks one or more yath log directories or .yath archives via the
# static streamer, dumps every event's encoded JSON line to disk as
# training samples, and feeds them to `zstd --train` to produce a
# pre-trained dictionary suitable for jsonl-per-line frame compression.
#
# The default output path is share/zstd/jsonl.dict (relative to the
# repo root, or wherever --out points). The default training output
# is a 32K dictionary, which is comfortably below ZSTD_initCStream's
# default window size while still giving useful gains on short jsonl
# events.
#
# Usage:
#   author_scripts/train_zstd_dict [options] LOG_OR_ARCHIVE [LOG_OR_ARCHIVE ...]
#
# Options:
#   --out PATH        Output dictionary path. Default: share/zstd/jsonl.dict
#   --maxdict SIZE    Pass through to zstd --maxdict. Default: 32K
#   --level N         Compression level used during training. Default: 3
#   --force           Overwrite an existing output dictionary
#   --keep-samples    Keep the temporary sample dir for inspection
#   --help            This message
#
# Requirements:
#   * The `zstd` binary on PATH (Compress::Zstd has no training API).
#   * Compress::Zstd installed (used to verify the resulting dict
#     loads cleanly via CompressionDictionary->new_from_file).

use Cwd qw/abs_path/;
use File::Basename qw/dirname/;
use File::Path qw/make_path/;
use File::Spec ();
use File::Temp qw/tempdir/;
use Getopt::Long qw/GetOptionsFromArray/;
use IPC::Cmd qw/can_run/;

use FindBin qw/$RealBin/;
use lib "$RealBin/../lib";

use App::Yath2::Streamer::Static;
use Test2::Harness2::Util::JSON qw/encode_json/;

my %opt = (
    out          => undef,
    maxdict      => '32K',
    level        => 3,
    force        => 0,
    keep_samples => 0,
);

my @argv = @ARGV;
GetOptionsFromArray(
    \@argv,
    'out=s'       => \$opt{out},
    'maxdict=s'   => \$opt{maxdict},
    'level=i'     => \$opt{level},
    'force'       => \$opt{force},
    'keep-samples' => \$opt{keep_samples},
    'help'        => sub { _usage(); exit 0 },
) or do { _usage(); exit 2 };

my @sources = @argv;
unless (@sources) {
    warn "error: no log directories or archives given\n\n";
    _usage();
    exit 2;
}

my $zstd = can_run('zstd')
    or die "error: 'zstd' binary not found on PATH; required for training\n";

my $repo_root = abs_path("$RealBin/..");
my $out_path  = $opt{out} // "$repo_root/share/zstd/jsonl.dict";

if (-e $out_path && !$opt{force}) {
    die "error: refusing to overwrite '$out_path' without --force\n";
}

make_path(dirname($out_path));

my $sample_dir = tempdir(
    'yath-zstd-train-XXXXXX',
    TMPDIR  => 1,
    CLEANUP => $opt{keep_samples} ? 0 : 1,
);

print STDERR "Sample dir: $sample_dir\n";
print STDERR "Output dict: $out_path\n";
print STDERR "Sources: @sources\n";

my $sample_count = 0;
my $sample_bytes = 0;

for my $src (@sources) {
    die "error: source '$src' does not exist\n" unless -e $src;

    print STDERR "Scanning '$src'...\n";

    my $streamer = App::Yath2::Streamer::Static->new(
        log    => $src,
        global => 1,
    );

    my $sample_idx = 0;
    open(my $fh, '>', "$sample_dir/source-$$-" . (++$sample_idx) . ".jsonl")
        or die "Could not open sample file: $!";
    binmode $fh;

    my $bytes_in_file = 0;

    while (my $event = $streamer->next) {
        my $line = encode_json($event) . "\n";
        print $fh $line;
        $sample_count++;
        $sample_bytes  += length $line;
        $bytes_in_file += length $line;

        # Roll over to a new sample file every ~256 KB so zstd --train
        # sees many short examples rather than a few giant ones (the
        # training algorithm samples up to ~1000 files by default).
        if ($bytes_in_file >= 256 * 1024) {
            close $fh;
            open($fh, '>', "$sample_dir/source-$$-" . (++$sample_idx) . ".jsonl")
                or die "Could not open sample file: $!";
            binmode $fh;
            $bytes_in_file = 0;
        }
    }

    close $fh;
}

if (!$sample_count) {
    die "error: no events collected from any source; nothing to train on\n";
}

printf STDERR "Collected %d events, %d bytes\n", $sample_count, $sample_bytes;

my @cmd = (
    $zstd,
    '--train',
    "--maxdict=$opt{maxdict}",
    "-$opt{level}",
    '-o', $out_path,
);
push @cmd => glob "$sample_dir/*";

print STDERR "Running: @cmd[0..5] ... <samples>\n";
system(@cmd) == 0 or die "zstd --train failed: $?\n";

# Sanity-load the produced dictionary so we fail loudly if zstd
# emitted something Compress::Zstd cannot parse.
unless (eval { require Compress::Zstd::CompressionDictionary; 1 }) {
    warn "warning: Compress::Zstd::CompressionDictionary not installed; "
        . "skipping load verification\n";
}
else {
    my $cdict = eval { Compress::Zstd::CompressionDictionary->new_from_file($out_path) };
    my $err = $@;
    die "error: trained dict at '$out_path' failed to load: $err\n" unless $cdict;
}

printf STDERR "Wrote dictionary to %s (%d bytes)\n", $out_path, -s $out_path;

if ($opt{keep_samples}) {
    print STDERR "Sample dir kept at: $sample_dir\n";
}

exit 0;

sub _usage {
    my $script = $0;
    print <<"USAGE";
Usage: $script [options] LOG_OR_ARCHIVE [LOG_OR_ARCHIVE ...]

Trains a zstd dictionary from one or more yath log directories or
.yath archives via the static streamer, then writes the dictionary
to share/zstd/jsonl.dict (or --out PATH).

Options:
  --out PATH         Output dictionary path
                     (default: <repo>/share/zstd/jsonl.dict)
  --maxdict SIZE     zstd --maxdict argument (default: 32K)
  --level N          zstd compression level used during training
                     (default: 3)
  --force            Overwrite an existing output dictionary
  --keep-samples     Keep the tempdir of training samples
  --help             This message

Examples:
  $script ~/work/logs
  $script --force /tmp/run-1.yath /tmp/run-2.yath
USAGE
    return;
}
