Another note on how preload launcher works

Preload launcher process starts, here is some pseudo-code, but nearly all of this is already implemented properly, favor how Collectors currently work over how my pseudo-code implements it.  But the collector reaps the test job process that spawns from it. Prelad spawns collector which spawns test job.
    use Test2::Harness2::Collector();
    use goto::file();
    my $action;
    BEGIN {
        preload modules ...
    
        $action = sub { exit(0) };
    
        my $got = long jump {
            service loop
                if launch
                    my $pid = fork
                    next if $pid
                    do long-jump - launch
        }
    
        return unless $got == launch;
    
        my ($stdout_r, $stdout_w) = Atomic::Pipe....
        my ($stderr_r, $stderr_w) = Atomic::Pipe....
    
        my $pid = fork // die;
        if ($pid) { # Collecter
            $action = sub {
                close($stdout_w)
                close($stderr_w)
                my $c = Test2::Harness2::Collector->...(stdout_pipe => $stdout_r, stderr_pipe => $stderr_r)
                $c->collect();
            };

            return;
        }
        else {
            close($stdout_r)
            close($stderr_r)

            # replace STDOUT and STDERR with the pipes
            # Clean up state, $0, etc

            goto::file->import(test_file)
        }
    }
    
    $action->();
    exit(0);

